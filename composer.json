{
    "name": "horde/service_facebook",
    "description": "Facebook Graph API client library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Service_Facebook",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "facebook",
        "graph",
        "oauth2",
        "oidc",
        "meta"
    ],
    "time": "2026-07-11",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "horde/oauth": "^4 || dev-FRAMEWORK_6_0",
        "horde/jwt": "^1 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "ext-json": "*"
    },
    "require-dev": {
        "horde/http": "^3.1.0 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/http": "Batteries-included PSR-18/17/7 client for Horde applications"
    },
    "autoload": {
        "psr-0": {
            "Horde_Service_Facebook": "lib/"
        },
        "psr-4": {
            "Horde\\Service\\Facebook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Service\\Facebook\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "4.x-dev"
        }
    }
}
